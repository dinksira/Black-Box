{
  "name": "black-box",
  "version": "1.0.0",
  "description": "Logic deduction desktop game",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run main:dev\" \"npm run renderer:dev\"",
    "main:dev": "webpack --config webpack.main.js --mode development --watch",
    "renderer:dev": "webpack serve --config webpack.renderer.js --mode development",
    "build:main": "webpack --config webpack.main.js --mode production",
    "build:renderer": "webpack --config webpack.renderer.js --mode production",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build:main && electron ."
  },
  "keywords": [
    "electron",
    "typescript",
    "logic-game"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-store": "^11.0.2"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@types/electron": "^1.4.38",
    "@types/node": "^25.0.3",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "electron-builder": "^26.0.12",
    "html-webpack-plugin": "^5.6.5",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  }
}
